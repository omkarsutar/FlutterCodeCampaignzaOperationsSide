CREATE FUNCTION public.reorder_agency_brand_links(p_link_id uuid, p_new_position integer) RETURNS TABLE(link_id uuid, agency_id uuid, brand_id uuid, visit_order integer, created_at timestamp with time zone, updated_at timestamp with time zone)
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_old_position INTEGER;
  v_agency_id UUID;
BEGIN
  -- Get the current position and agency_id of the item being moved
  SELECT rsl.visit_order, rsl.agency_id 
  INTO v_old_position, v_agency_id
  FROM agency_brand_links rsl
  WHERE rsl.link_id = p_link_id;

  -- If moving down (increasing position)
  IF p_new_position > v_old_position THEN
    -- Shift items between old and new position up by 1
    UPDATE agency_brand_links rsl
    SET visit_order = rsl.visit_order - 1
    WHERE rsl.agency_id = v_agency_id
      AND rsl.visit_order > v_old_position
      AND rsl.visit_order <= p_new_position;
  
  -- If moving up (decreasing position)
  ELSIF p_new_position < v_old_position THEN
    -- Shift items between new and old position down by 1
    UPDATE agency_brand_links rsl
    SET visit_order = rsl.visit_order + 1
    WHERE rsl.agency_id = v_agency_id
      AND rsl.visit_order >= p_new_position
      AND rsl.visit_order < v_old_position;
  END IF;

  -- Update the moved item to its new position
  UPDATE agency_brand_links rsl
  SET visit_order = p_new_position
  WHERE rsl.link_id = p_link_id;

  -- Return all items for this agency in the new order
  RETURN QUERY
  SELECT 
    rsl.link_id,
    rsl.agency_id,
    rsl.brand_id,
    rsl.visit_order,
    rsl.created_at,
    rsl.updated_at
  FROM agency_brand_links rsl
  WHERE rsl.agency_id = v_agency_id
  ORDER BY rsl.visit_order ASC;
END;
$$;


