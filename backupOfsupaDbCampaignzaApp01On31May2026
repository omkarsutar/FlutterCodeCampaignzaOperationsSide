CREATE FUNCTION public.update_campaign_totals() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_collab_count integer;
BEGIN
  -- Get the current count of collaborations
  SELECT COUNT(*) INTO v_collab_count
  FROM collaborations
  WHERE campaign_id = COALESCE(NEW.campaign_id, OLD.campaign_id);

  -- Recalculate aggregates for the affected campaign
  UPDATE campaign
  SET
    -- Count of line items (collaborations)
    collaboration_count = v_collab_count,

    -- Update status if count > 0 and current status is 'pending'
    status = CASE 
      WHEN v_collab_count > 0 AND status = 'pending' THEN 'confirmed'
      ELSE status
    END,

    -- Always refresh updated_at
    updated_at = NOW()
  WHERE campaign_id = COALESCE(NEW.campaign_id, OLD.campaign_id);

  RETURN NULL;
END;
$$;


