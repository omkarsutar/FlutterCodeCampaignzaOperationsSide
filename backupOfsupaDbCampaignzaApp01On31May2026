CREATE FUNCTION public._collaboration_count_and_status_adjust(p_campaign_id uuid) RETURNS void
    LANGUAGE plpgsql
    AS $$
DECLARE
  cnt int;
BEGIN
  IF p_campaign_id IS NULL THEN
    RETURN;
  END IF;

  SELECT COUNT(*) INTO cnt FROM public.collaborations WHERE campaign_id = p_campaign_id;

  -- Keep collaboration_count in sync
  UPDATE public.campaign
  SET collaboration_count = cnt
  WHERE campaign_id = p_campaign_id
    AND (collaboration_count IS DISTINCT FROM cnt);

  -- If zero items -> ensure status = 'pending'
  IF cnt = 0 THEN
    UPDATE public.campaign
    SET status = 'pending'
    WHERE campaign_id = p_campaign_id
      AND status IS DISTINCT FROM 'pending';
    RETURN;
  END IF;

  -- If >=1 item and campaign currently pending -> set confirmed
  UPDATE public.campaign
  SET status = 'confirmed'
  WHERE campaign_id = p_campaign_id
    AND status = 'pending';
END;
$$;


