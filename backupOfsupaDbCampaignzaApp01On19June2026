CREATE FUNCTION public.get_install_count_by_referrer(p_referrer_raw text) RETURNS integer
    LANGUAGE plpgsql STABLE SECURITY DEFINER
    AS $$
DECLARE
    v_source text;
    v_medium text;
    v_campaign text;
    v_package text;
BEGIN
    -- Decode the incoming referrer string
    p_referrer_raw := public.decode_url(p_referrer_raw);

    -- Extract UTM parameters using regex
    v_source   := substring(p_referrer_raw from 'utm_source=([^&]+)');
    v_medium   := substring(p_referrer_raw from 'utm_medium=([^&]+)');
    v_campaign := substring(p_referrer_raw from 'utm_campaign=([^&]+)');

    -- Extract package name (id=...)
    v_package  := substring(p_referrer_raw from 'id=([^&]+)');

    RETURN (
        SELECT count(*)::integer
        FROM public.app_install_tracking
        WHERE utm_source   = COALESCE(v_source, utm_source)
          AND utm_medium   = COALESCE(v_medium, utm_medium)
          AND utm_campaign = COALESCE(v_campaign, utm_campaign)
          AND package_name = COALESCE(v_package, package_name)
    );
END;
$$;


